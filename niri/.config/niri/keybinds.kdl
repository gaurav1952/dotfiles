
binds {

    Mod+X {
        spawn-sh "qs -c noctalia-shell ipc call sessionMenu toggle"
    }
    Mod+Shift+W {
        spawn-sh "qs -c noctalia-shell ipc call plugin:wallcards toggle"
    }
    Mod+Shift+V {
        spawn-sh "vicinae 'vicinae://launch/clipboard/history'"
    }
    Print {
        spawn-sh "FILE=~/Pictures/Screenshots/shot_$(date +%F_%H-%M-%S).png && grim - | satty --filename - --output-filename \"$FILE\" --early-exit && wl-copy --type image/png < \"$FILE\""
    }

    Mod+Shift+S {
        spawn-sh "FILE=~/Pictures/Screenshots/shot_$(date +%F_%H-%M-%S).png && grim -g \"$(slurp)\" - | satty --filename - --output-filename \"$FILE\" --early-exit && wl-copy --type image/png < \"$FILE\""
    }
    
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+E {spawn "thunar";}
    Mod+period repeat=false {spawn "vicinae" "vicinae://launch/core/search-emojis";}

    Mod+slash {spawn-sh "~/.dotfiles/scripts/shell_script.sh";}
    Mod+t{spawn "kitty";}

    Alt+A { spawn "wtype" "-k" "Home" "-M" "shift" "-k" "End" "-m" "shift"; }
    // Alternative commands that move across workspaces when reaching
    // the first or last window in a column.
    // Mod+Ctrl+J     { move-window-down-or-to-workspace-down; }
    // Mod+Ctrl+K     { move-window-up-or-to-workspace-up; }

// Generated by Tide Island. Edit shortcuts in the Tide Island config app.
// These binds call Quickshell IPC; the same commands can be reused in scripts.
    Super+Right { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "tide" "swipeRight"; }
    Super+Left { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "tide" "swipeLeft"; }
    Super+Down { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "tide" "showClock"; }
    Super+M { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "tide" "togglePlayer"; }
    Super+C { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "tide" "toggleControlCenter"; }
    Super+N { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "tide" "toggleNotificationCenter"; }
    Super+W { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "tide" "toggleWallpaperPicker"; }
    Super+slash { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "tide" "toggleApplicationLauncher"; }
    Super+F { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "island" "toggle"; }

  }
