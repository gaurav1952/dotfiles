{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.dotfiles/fastfetch/.config/fastfetch/krishna1.png",
    "color": {"1": "#c0c1ff", "2": "white"},
    "padding": {
      "top": 4,
      "right": 5
    },
    "height": 18
  },
  "display": {
    "separator": " ▸ " // :
  },
"modules": [
  {
    "type": "title"
  },
"break",
{
  "type": "custom",
  "format": "\u001b[90m┌────────────────────── Operating System ──────────────────────┐"
},
{
  "type": "os",
  "key": "󰨡 OS:",
  "keyColor": "#c0c1ff"
},
{
  "type": "kernel",
  "key": "│ Kernel:  ",
  "keyColor": "#c0c1ff"
},
{
  "type": "shell",
  "key": "│ Shell:  ",
  "keyColor": "#c0c1ff"
},
{
  "type": "terminal",
  "key": "│ Terminal:  ",
  "keyColor": "#c0c1ff"
},
{
  "type": "terminalfont",
  "key": "│ Terminal Font:  ",
  "keyColor": "#c0c1ff"
},
{
  "type": "lm",
  "key": "│ DM: 󰌾 ",
  "keyColor": "#c0c1ff"
},
{
  "type": "de",
  "key": "│ DE:  ",
  "keyColor": "#c0c1ff"
},
{
  "type": "wm",
  "key": "│ WM:  ",
  "keyColor": "#c0c1ff"
},
{
  "type": "wmtheme",
  "key": "│ WM Theme: 󰃣 ",
  "keyColor": "#c0c1ff"
},
{
  "type": "packages",
  "key": "└ Packages:  ",
  "keyColor": "#c0c1ff"
},
{
  "type": "custom",
  "format": "\u001b[90m├────────────────────── Device ────────────────────────────────┤"
},
{
  "type": "host",
  "key": "󰟀 Host:",
  "keyColor": "#c5c4dd"
},
{
  "type": "bios",
  "key": "│ BIOS:  ",
  "keyColor": "#c5c4dd"
},
{
  "type": "memory",
  "key": "│ RAM Memory:  ",
  "keyColor": "#c5c4dd"
},
{
  "type": "swap",
  "key": "│ Swap: 󰾴 ",
  "keyColor": "#c5c4dd"
},
{
  "type": "cpu",
  "key": "│ Processor: 󰍛 ",
  "keyColor": "#c5c4dd"
},
{
  "type": "gpu",
  "key": "│ Videocard: 󰢮 ",
  "keyColor": "#c5c4dd"
},
{
  "type": "disk",
  "key": "│ Storage:  ",
  "keyColor": "#c5c4dd"
},
{
  "type": "battery",
  "key": "└ Battery: 󰁹 ",
  "keyColor": "#c5c4dd"
},
{
  "type": "custom",
  "format": "\u001b[90m├────────────────────── Others Configurations ─────────────────┤"
},
{
  "type": "uptime",
  "key": " Uptime:",
  "keyColor": "#e8b9d4"
},
{
   "type": "datetime",
   "key": "│ DateTime:  ",
   "keyColor": "#e8b9d4"
},
{
   "type": "command",
   "key": "│ OS Time Life:  ",
   "keyColor": "#e8b9d4",
   "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
},
{
  "type": "locale",
  "key": "└ Locale: 󰇧 ",
  "keyColor": "#e8b9d4"
},
{
  "type": "custom",
  "format": "\u001b[90m└──────────────────────────────────────────────────────────────┘"
},
{
  "type": "colors",
  "paddingLeft": 24,
  "symbol": "circle",
  "block": {
    "width": 10
  }
},
"break",
]
}
